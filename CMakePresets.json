{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "HCS_BUILD_TESTS": "ON",
        "HCS_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "windows-base",
      "displayName": "Windows x64 Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "windows-base",
      "displayName": "Windows x64 Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "inherits": "windows-base",
      "displayName": "Windows x64 RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-cpu-only",
      "inherits": "windows-base",
      "displayName": "Windows x64 CPU only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HCS_ENABLE_VULKAN": "OFF"
      }
    },
    {
      "name": "windows-vulkan",
      "inherits": "windows-base",
      "displayName": "Windows x64 with Vulkan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HCS_ENABLE_VULKAN": "ON"
      }
    },
    {
      "name": "windows-analyze",
      "inherits": "windows-base",
      "displayName": "Windows x64 MSVC static analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HCS_STATIC_ANALYSIS": "ON"
      }
    },
    {
      "name": "windows-validation",
      "inherits": "windows-base",
      "displayName": "Windows x64 Vulkan validation tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HCS_ENABLE_VULKAN": "ON",
        "HCS_VALIDATION_LAYERS": "ON"
      }
    },
    {
      "name": "windows-tests",
      "inherits": "windows-base",
      "displayName": "Windows x64 test build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HCS_ENABLE_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-relwithdebinfo",
      "configurePreset": "windows-relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-cpu-only",
      "configurePreset": "windows-cpu-only",
      "configuration": "Release"
    },
    {
      "name": "windows-vulkan",
      "configurePreset": "windows-vulkan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-tests",
      "configurePreset": "windows-tests",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-validation",
      "configurePreset": "windows-validation",
      "configuration": "Debug"
    },
    {
      "name": "windows-analyze",
      "configurePreset": "windows-analyze",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-validation",
      "configurePreset": "windows-validation",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-tests",
      "configurePreset": "windows-tests",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-cpu-only",
      "configurePreset": "windows-cpu-only",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "configurePreset": "windows-relwithdebinfo",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-vulkan",
      "configurePreset": "windows-vulkan",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
