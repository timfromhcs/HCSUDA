#version 450
// HCSUDA built-in kernel: 256-bin histogram of u32 values (masked to 8 bits).
// Bins are zeroed by the first workgroup invocation group before atomic updates.
layout(local_size_x = 256) in;

layout(binding = 0) buffer X { uint values[]; };
layout(binding = 1) buffer H { uint hist[]; };

layout(push_constant) uniform PC {
    uint n;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

void main()
{
    uint lid = gl_LocalInvocationID.x;
    if (lid < 256u) {
        hist[lid] = 0u;
    }
    barrier();

    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += 256u * gl_NumWorkGroups.x) {
        atomicAdd(hist[values[i] & 255u], 1u);
    }
}
