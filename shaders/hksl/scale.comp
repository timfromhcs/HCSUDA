#version 450
// HCSUDA built-in kernel: y = alpha * x
layout(local_size_x = 64) in;

layout(binding = 0) buffer X { float x[]; };
layout(binding = 1) buffer Y { float y[]; };

layout(push_constant) uniform PC {
    uint n;
    float alpha;
    uint pad0;
    uint pad1;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.n) {
        y[i] = pc.alpha * x[i];
    }
}
