#version 450
// HCSUDA built-in kernel: single-workgroup final reduction.
// out[0] = sum(partials[0 .. n-1]) produced by reduce_sum_f32.
// Bounds are clamped to the storage buffer size on the host.
layout(local_size_x = 256) in;

layout(binding = 0) buffer P { float partials[]; };
layout(binding = 1) buffer O { float outv[]; };

layout(push_constant) uniform PC {
    uint n;
    uint pad0;
    uint pad1;
    uint pad2;
} pc;

shared float scratch[256];

void main()
{
    uint lid = gl_LocalInvocationID.x;
    float sum = 0.0;
    for (uint i = lid; i < pc.n; i += 256u) {
        sum += partials[i];
    }
    scratch[lid] = sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (lid < stride) {
            scratch[lid] += scratch[lid + stride];
        }
        barrier();
    }

    if (lid == 0u) {
        outv[0] = scratch[0];
    }
}
