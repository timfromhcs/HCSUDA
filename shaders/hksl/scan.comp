#version 450

/* Exclusive prefix sum within one contiguous chunk of arbitrary length.
 * The chunk is processed in 256-element blocks; 'running' carries the prefix
 * total across blocks inside the same workgroup. The caller adds chunk totals. */
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer HcsInput {
    float src_data[];
};

layout(std430, binding = 1) buffer HcsOutput {
    float dst_data[];
};

layout(push_constant) uniform Params {
    uint n;
    uint groups;
    uint pad0;
    uint pad1;
};

shared float scratch[256];
shared float running;

void main()
{
    const uint lid = gl_LocalInvocationID.x;
    const uint chunk = (n + groups - 1u) / groups;
    const uint start = gl_WorkGroupID.x * chunk;
    if (lid == 0u) {
        running = 0.0;
    }
    barrier();

    for (uint base = 0u; base < chunk; base += 256u) {
        const uint index = base + lid;
        const uint globalIndex = start + index;
        const bool inRange = (index < chunk) && (globalIndex < n);
        const float value = inRange ? src_data[globalIndex] : 0.0f;
        scratch[lid] = value;
        barrier();

        for (uint offset = 1u; offset < 256u; offset <<= 1u) {
            const float mine = scratch[lid];
            const float other = lid >= offset ? scratch[lid - offset] : 0.0f;
            barrier();
            scratch[lid] = mine + other;
            barrier();
        }

        const float prefixBefore = scratch[lid] - value; /* inclusive - own value */
        if (inRange) {
            dst_data[globalIndex] = prefixBefore + running;
        }
        const float blockSum = scratch[255];
        barrier();
        if (lid == 0u) {
            running += blockSum;
        }
        barrier();
    }
}
